# =====================================================================
# Halal Crypto AI Spot Trading Agent Configuration (.env.example)
# =====================================================================

# Binance Spot API Keys
# IMPORTANT:
# 1. Enable ONLY "Can Read" and "Enable Spot & Margin Trading" (Keep Margin UNCHECKED).
# 2. NEVER enable "Enable Withdrawals".
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_USE_TESTNET=false

# Paper Trading Mode (true for safe simulation, false for real Binance spot)
PAPER_TRADING=true
INITIAL_PAPER_BALANCE_USDT=1000.0

# Screened Halal Spot Trading Pairs
# Ranked by halal_swing_scan.py (2026-10-12): liquidity + ATR% + trend. ETH/SOL excluded
# (neutral trend), DOT/POL excluded (<$10M 24h liquidity gate).
TRADING_PAIRS=["NEARUSDT", "ADAUSDT", "AVAXUSDT", "LINKUSDT", "BTCUSDT", "XAUTUSDT"]

# Timeframe & Risk Management
CANDLE_TIMEFRAME=4h
CANDLE_LIMIT=260
POLL_INTERVAL_SECONDS=300
REQUIRE_CLOSED_CANDLE=true
MAX_ALLOCATION_PER_TRADE_PERCENT=20.0
RISK_PER_TRADE_PERCENT=1.0
MAX_OPEN_POSITIONS=4
MIN_RISK_REWARD_RATIO=1.5
ATR_STOP_LOSS_MULTIPLIER=2.5
ATR_TAKE_PROFIT_MULTIPLIER=5.0

# Strict Exit Policy: routine positions close ONLY via pre-committed SL/TP.
# Trailing stops and AI/regime exits are disabled while this is true.
STRICT_SL_TP_EXIT_ONLY=true
# Exchange-side protection (live mode): attach OCO after each buy.
# VERIFY ON TESTNET (BINANCE_USE_TESTNET=true) BEFORE ENABLING IN PRODUCTION.
PROTECT_WITH_EXCHANGE_OCO=false

# Anti-churn (applies only when STRICT_SL_TP_EXIT_ONLY=false)
MIN_HOLD_MINUTES=720
AI_EXIT_MIN_EDGE_PERCENT=1.5
SYMBOL_REENTRY_COOLDOWN_MINUTES=360

# AI Provider Configuration
# Options: 'algorithmic' (Offline, zero API fee), 'gemini', 'openai', or 'custom'
AI_PROVIDER=algorithmic
AI_CONFIDENCE_THRESHOLD=0.80

# Google Gemini / OpenAI Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Custom OpenAI-Compatible Endpoints (DeepSeek, OpenRouter, Groq, Ollama, LM Studio)
# Examples:
# DeepSeek:   CUSTOM_BASE_URL=https://api.deepseek.com/v1          CUSTOM_MODEL_NAME=deepseek-chat
# OpenRouter: CUSTOM_BASE_URL=https://openrouter.ai/api/v1         CUSTOM_MODEL_NAME=deepseek/deepseek-r1
# Groq:       CUSTOM_BASE_URL=https://api.groq.com/openai/v1       CUSTOM_MODEL_NAME=llama-3.3-70b-versatile
# Ollama:     CUSTOM_BASE_URL=http://localhost:11434/v1            CUSTOM_MODEL_NAME=llama3
# LM Studio:  CUSTOM_BASE_URL=http://localhost:1234/v1             CUSTOM_MODEL_NAME=local-model
CUSTOM_BASE_URL=https://api.deepseek.com/v1
CUSTOM_MODEL_NAME=deepseek-chat
CUSTOM_API_KEY=
